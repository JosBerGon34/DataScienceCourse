    "#So our PMF looks like this :\n",
    "import scipy.stats\n",
    "import numpy as np\n",
    "from scipy.stats import binom\n",
    "\n",
    "k = np.unique(dfsurvey['trstplt'])\n",
    "PMF = dfsurvey['trstplt'].value_counts(normalize=True).reindex(k, fill_value=0)\n",
